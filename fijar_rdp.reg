Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\rdp]
@="URL:Remote Desktop Protocol"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\rdp\DefaultIcon]
@="mstsc.exe,0"

[HKEY_CLASSES_ROOT\rdp\shell]

[HKEY_CLASSES_ROOT\rdp\shell\open]

[HKEY_CLASSES_ROOT\rdp\shell\open\command]
@="powershell.exe -WindowStyle Hidden -Command \"$u='%1'; $u=$u.Trim('\"'); $u=$u -replace 'rdp://',''; $u=$u.Trim('/'); Start-Process mstsc.exe -ArgumentList ('/v:'+$u)\""
