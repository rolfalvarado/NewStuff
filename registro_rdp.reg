Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\rdp]
@="URL:Remote Desktop Protocol"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\rdp\shell]
[HKEY_CLASSES_ROOT\rdp\shell\open]
[HKEY_CLASSES_ROOT\rdp\shell\open\command]
@="powershell.exe -WindowStyle Hidden -Command \"if ('%1' -match 'full address=s:([^&]+)') { $ip = $matches[1]; if ('%1' -match 'username=s:([^&]+)') { $user = $matches[1]; mstsc.exe /v:$ip /w:$user } else { mstsc.exe /v:$ip } }\""

