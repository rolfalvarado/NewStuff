{
  "name": "stuff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "start:db": "node scripts/start-db.js",
    "start:monitor": "node scripts/monitor-service.js",
    "start:prod": "concurrently --names \"DB,NEXT,MON\" --prefix-colors \"cyan,magenta,yellow\" \"npm run start:db\" \"npm run start\" \"npm run start:monitor\"",
    "start:all": "concurrently --names \"DB,NEXT\" --prefix-colors \"cyan,magenta\" \"npm run start:db\" \"npm run dev\"",
    "setup": "node scripts/setup-db.js && node scripts/init-tables.js && node scripts/seed-users.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.958.0",
    "@aws-sdk/client-ec2": "^3.958.0",
    "@aws-sdk/lib-dynamodb": "^3.958.0",
    "bcryptjs": "^3.0.3",
    "googleapis": "^171.4.0",
    "guacamole-common-js": "^1.5.0",
    "guacamole-lite": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "typescript": "^5"
  }
}
